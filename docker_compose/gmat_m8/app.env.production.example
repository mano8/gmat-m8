# Django settings for the production stack (read by web and migrate through env_file).
# Copy to app.env on the VPS, replace every value, mode 0600. Nothing here is a default:
# the application refuses to start on a missing, weak or placeholder value.
# Database credentials are not here: they come from .env.

DJANGO_SETTINGS_MODULE=config.settings.prod

# Generate with: openssl rand -base64 60 | tr -d '\n=+/'
DJANGO_SECRET_KEY=
# Comma-separated Fernet keys, newest first. Generate with: openssl rand -base64 32 | tr '+/' '-_'
# Keep an offline copy: losing every key means all users re-enrol TOTP.
MFA_ENCRYPTION_KEYS=

# The public host name(s) and the https origin(s), exactly as users type them.
DJANGO_ALLOWED_HOSTS=gmat.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://gmat.example.org

# HSTS, off until you turn it on, one switch at a time (docs/runbooks/vps-setup.md): a browser
# that has seen the header refuses plain HTTP for as long as it said, and that cannot be taken
# back. `web` logs a warning at startup while any of these is off; a deploy does not fail on it.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# Session lifetimes in seconds (privileged accounts: 12 h, others: 14 days).
DJANGO_SESSION_AGE_SECONDS=1209600
DJANGO_PRIVILEGED_SESSION_AGE_SECONDS=43200

# --- Mail (plan §5): requests queue mail in the outbox; only the worker sends it -------
# Comma-separated Fernet keys, newest first, generated like MFA_ENCRYPTION_KEYS and never
# one of them. They seal reset links and invitations for at most an hour.
OUTBOX_ENCRYPTION_KEYS=
# on: the worker delivers through EMAIL_HOST; off (or unset): nothing is ever sent.
OUTBOUND_EMAIL=on
# on: issuing or amending a purchase order emails it to the supplier (M5.3); off: the
# printable page only (ADR-0010, Q7). Cancellation notices for orders already sent go out
# either way.
PO_DISPATCH=off
# The SMTP relay (submission port, STARTTLS). Its password is SMTP_PASSWORD in .env:
# compose passes it to the worker only, never to web.
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
DJANGO_DEFAULT_FROM_EMAIL=gmat-m8 <no-reply@gmat.example.org>
# Optional error tracking (Sentry-compatible DSN, scrubbed, off by default):
# ERROR_TRACKING_DSN=

# --- Attachments (M6.4, Q22) ----------------------------------------------------------
# Total storage for photos and PDFs, in MiB (an alert is logged and audited at 80 %).
ATTACHMENT_STORAGE_LIMIT_MB=5120
