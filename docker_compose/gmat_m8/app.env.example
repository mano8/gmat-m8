# Django settings for the local and test stack (read by web and migrate through env_file).
# `bash init.sh` copies this file to `app.env`, fills every __GENERATE_*__ and __FROM_ENV_*__
# value and sets mode 0600. Database credentials are not here: they come from .env.
#
# These are production settings (config.settings.prod) with local-friendly values; the
# stack fails to start on a missing, weak or placeholder value.

DJANGO_SETTINGS_MODULE=config.settings.prod

# Cryptographic keys. Rotating DJANGO_SECRET_KEY ends every session and reset link.
# MFA_ENCRYPTION_KEYS is a comma-separated list, newest first; keep an offline copy: losing
# every key means all users re-enrol TOTP.
DJANGO_SECRET_KEY=__GENERATE_SECRET__
MFA_ENCRYPTION_KEYS=__GENERATE_FERNET__

# Filled from APP_DOMAIN, HTTPS_PORT in .env.
DJANGO_ALLOWED_HOSTS=__FROM_ENV_HOSTS__
DJANGO_CSRF_TRUSTED_ORIGINS=__FROM_ENV_ORIGINS__

# A short HSTS lifetime locally: browsers apply it to every port of `localhost`.
DJANGO_HSTS_SECONDS=60
DJANGO_LOG_LEVEL=INFO

# Session lifetimes in seconds (privileged accounts: 12 h, others: 14 days).
DJANGO_SESSION_AGE_SECONDS=1209600
DJANGO_PRIVILEGED_SESSION_AGE_SECONDS=43200

# --- Mail (plan §5): requests queue mail in the outbox; only the worker sends it -------
# Seal sensitive outbox bodies (reset links). Comma-separated, newest first, never an MFA
# key; a sealed body lives at most an hour, so a rotation only needs the old key that long.
OUTBOX_ENCRYPTION_KEYS=__GENERATE_FERNET__
# on: the worker delivers; off: it never claims a message or opens an SMTP connection.
OUTBOUND_EMAIL=on
# The local stack delivers to Mailpit (docker-compose.local-mail.yml, loaded through .env's
# COMPOSE_FILE): nothing leaves the host. The SMTP password, if any, is SMTP_PASSWORD in .env (it reaches the worker only).
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
