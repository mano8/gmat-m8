# Caddy for gmat-m8 (plan §7.3): TLS, compression, body and header limits, the maintenance
# gate, the reverse proxy to Django, the redacted access log and the fallback page.
#
# Security headers are set by Django (one place, covered by tests), not here.
# Caddy is the only HTTP access log. It writes the one X-Forwarded-For Django reads: the address
# it observed, or in the tunnel's mode the one the connector names, believed from that connector's
# address alone (ADR-0034). A client's own X-Forwarded-For or CF-Connecting-IP never reaches Django.
#
# The edge modes (ADR-0034), all off by default: each import names one file of caddy/edge/ by the
# value compose passes (EDGE_TLS, EDGE_PROXY), and that file defines the named snippets imported
# below. A value outside the allowlist names no file, or two, and Caddy refuses to start;
# ops/checks.py edge refuses it before that.
import edge/tls-{$EDGE_TLS}.caddy
import edge/proxy-{$EDGE_PROXY}.caddy

# Global options.
{
	# EDGE_TLS=files: no certificate from ACME, and the file's for a client that names no host.
	import edge-tls-global

	# No admin API: nothing can reconfigure Caddy at run time.
	admin off

	# Listening ports: unprivileged, since Caddy runs as uid 1000 with no capability. Locally they
	# are also the published ones; production publishes 80 and 443 onto 8080 and 8443. Links and
	# redirects use HTTPS_PORT_SUFFIX and Alt-Svc uses ALT_SVC_PORT, the ports visitors reach.
	# ACME's challenges reach these ports through the published ones.
	http_port {$HTTP_PORT:8080}
	https_port {$HTTPS_PORT:8443}

	email {$ACME_EMAIL:internal@localhost}

	# Never try to install the internal CA into the container's trust store (read-only
	# root filesystem, no capabilities); browsers trust it by import or by accepting it.
	skip_install_trust

	servers {
		# HTTP/3 needs the UDP port, which only the production overlay publishes.
		protocols {$HTTP_PROTOCOLS:h1 h2}
		timeouts {
			read_header 10s
			read_body {$CADDY_READ_BODY_TIMEOUT:120s}
			idle 5m
		}
		# EDGE_PROXY=cloudflare: whom Caddy believes about the visitor's address.
		import edge-proxy-servers
	}

	# Runtime and error logs (they can carry request URIs) get the same redaction as the
	# access log below.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "^(/accounts/password/reset/key/|/account/email-change/|/invite/)[^?]*|(\?).*$" "${1}${2}REDACTED"
				request>headers>Referer delete
				request>headers>Hx-Current-Url delete
				request>headers>Cf-Access-Jwt-Assertion delete
				resp_headers>Location delete
			}
		}
	}
}

# What both proxies send web about the visitor, in every mode. Without a trusted proxy {client_ip}
# is the peer, so this is Caddy's own value; with one, Caddy would otherwise append the connector's
# address and Django, which believes the last entry, would see it. CF-Connecting-IP never reaches
# web, even from a peer Caddy does not believe.
(web-forwarded) {
	header_up X-Forwarded-For {client_ip}
	header_up -Cf-Connecting-Ip
	# EDGE_PROXY=cloudflare: what else Caddy would take from the connector is Caddy's own again.
	import edge-proxy-upstream
}

# Plain HTTP only redirects, to the port users actually reach (HTTPS_PORT_SUFFIX is ":8443"
# locally and empty in production). ACME HTTP challenges are answered before this route.
http://{$APP_DOMAIN:localhost}:{$HTTP_PORT:8080} {
	redir https://{host}{$HTTPS_PORT_SUFFIX}{uri} 308
}

# EDGE_EXTRA_HOST, empty by default, is one more name for the same site (the tunnel's). Its plain
# HTTP gets Caddy's own redirect, which names no port: the published 443 in production.
{$APP_DOMAIN:localhost}:{$HTTPS_PORT:8443} {$EDGE_EXTRA_HOST} {
	# EDGE_TLS=files: the certificate and key of tls/. EDGE_PROXY=cloudflare: no-transform.
	import edge-tls-site
	import edge-proxy-site

	encode zstd gzip

	# Neither Caddy nor Gunicorn announces itself.
	header -Server

	# With HTTP/3 on, Caddy advertises the port it listens on (8443 in production), where HTTP/3
	# clients would then go: name the one visitors reach. Without HTTP/3 there is no Alt-Svc and
	# this adds none. It applies to the gate's and the fallback's 503 too (measured).
	header Alt-Svc `h3=":{$HTTPS_PORT:8443}"` `h3=":{$ALT_SVC_PORT:8443}"`

	request_body {
		max_size {$MAX_UPLOAD_SIZE:11MiB}
	}

	route {
		# Maintenance gate: evaluated first, independent of whether web is running.
		@maintenance file {
			root /srv/flags
			try_files maintenance.on
		}
		handle @maintenance {
			# A form post gets the page too: the file server alone would answer 405.
			@write not method GET HEAD
			method @write GET
			root * /srv/maintenance
			rewrite * /index.html
			header Cache-Control "no-store"
			header Retry-After "120"
			file_server {
				status 503
			}
		}

		# The admin is optional (ADR-0030). Off, its prefix goes to Django like any unknown path
		# (404). On, only the allowed networks reach it and anyone else gets a 404 here. Only the
		# words that turn it off (or nothing) skip the gate: a spelling Django reads as on never
		# opens it. Without an allowlist nobody gets in: an empty value matches no address, and the
		# loopback default below applies only to a variable that is absent altogether.
		@admin {
			path /{$ADMIN_URL_PATH:admin} /{$ADMIN_URL_PATH:admin}/*
			not expression `"{$DJANGO_ADMIN_ENABLED}" in ["", "0", "false", "no", "off"]`
		}
		handle @admin {
			@blocked not remote_ip {$ADMIN_ALLOWED_CIDRS:127.0.0.1/32 ::1/128}
			respond @blocked 404
			reverse_proxy web:8000 {
				header_up X-Request-ID {http.request.uuid}
				import web-forwarded
				transport http {
					dial_timeout 3s
				}
			}
		}

		handle {
			reverse_proxy web:8000 {
				header_up X-Request-ID {http.request.uuid}
				import web-forwarded
				transport http {
					dial_timeout 3s
				}
			}
		}
	}

	# web unreachable (restart, deploy): the same page as the gate.
	handle_errors 502 503 504 {
		@write not method GET HEAD
		method @write GET
		root * /srv/maintenance
		rewrite * /index.html
		header Cache-Control "no-store"
		header Retry-After "120"
		file_server {
			status 503
		}
	}

	# The only access log. Token-bearing paths and every query string are redacted on every host
	# name, and the headers that can carry a full URL are dropped: Referer and HX-Current-URL, and
	# the response's Location (Django's slash-appending 301 for a token link opened without its
	# trailing slash points at the token URL). So is Cf-Access-Jwt-Assertion, Cloudflare Access's
	# token for the person, which carries their email. Credential headers (Cookie, where Access's
	# own cookie sits, and Authorization) stay redacted by Caddy's default; never enable
	# log_credentials.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "^(/accounts/password/reset/key/|/account/email-change/|/invite/)[^?]*|(\?).*$" "${1}${2}REDACTED"
				request>headers>Referer delete
				request>headers>Hx-Current-Url delete
				request>headers>Cf-Access-Jwt-Assertion delete
				resp_headers>Location delete
			}
		}
	}
}
