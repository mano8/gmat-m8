# Compose-level settings for the gmat-m8 stack (read by `docker compose` on the host).
# `bash init.sh` copies this file to `.env`, fills every __GENERATE_*__ value with a strong
# random one and sets mode 0600. Each secret is defined ONCE here and reaches the services by
# interpolation; the Django-only settings live in app.env.
#
# Never commit .env. Never reuse these values elsewhere.

# --- Public address -------------------------------------------------------------------
# `localhost` uses Caddy's internal CA (trust it or accept the browser warning). A real
# domain uses ACME in the production overlay; set ACME_EMAIL then.
APP_DOMAIN=localhost
ACME_EMAIL=
# Ports Caddy listens on (inside the container and on the host). The production overlay
# forces 80 and 443.
BIND_IP=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Pinned subnet of the `edge` network, shared only by Caddy and web. Gunicorn trusts
# forwarded headers from this subnet and nothing else.
EDGE_SUBNET=172.30.80.0/24

# Caddy limits. A stalled request body is cut after CADDY_READ_BODY_TIMEOUT.
MAX_UPLOAD_SIZE=15MB
CADDY_READ_BODY_TIMEOUT=120s
# URL prefix of the Django admin (no slashes) and the networks allowed to reach it.
ADMIN_URL_PATH=admin
ADMIN_ALLOWED_CIDRS=0.0.0.0/0 ::/0

# --- Images ---------------------------------------------------------------------------
# Local builds are tagged with these names. The production overlay ignores them and uses
# the signed digests below.
APP_IMAGE=gmat-m8:local
BACKUP_IMAGE=gmat-m8-backup:local
APP_VERSION=dev
APP_DIGEST=
BACKUP_DIGEST=

# --- Database ---------------------------------------------------------------------------
POSTGRES_DB=gmat
# Bootstrap superuser: used by PostgreSQL's first start only, never by the application.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE_PASSWORD__
# Application roles (docker/postgres/initdb/10-roles.sh): owner = migrations only,
# runtime = web and worker (data access only), backup = read-only.
GMAT_DB_OWNER_USER=gmat_owner
GMAT_DB_OWNER_PASSWORD=__GENERATE_PASSWORD__
GMAT_DB_RUNTIME_USER=gmat_app
GMAT_DB_RUNTIME_PASSWORD=__GENERATE_PASSWORD__
GMAT_DB_BACKUP_USER=gmat_backup
GMAT_DB_BACKUP_PASSWORD=__GENERATE_PASSWORD__

# --- Web ----------------------------------------------------------------------------------
GUNICORN_WORKERS=3

# --- Mail ---------------------------------------------------------------------------------
# `docker compose` without -f also loads Mailpit, the local mail sink the worker delivers to
# (app.env: EMAIL_HOST=mailpit). Production and the restore drill always pass -f, so this
# never applies there; delete both lines on the VPS anyway.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.local-mail.yml
# Password of the SMTP account named in app.env (EMAIL_HOST_USER). Only the worker gets it.
SMTP_PASSWORD=

# --- Backups ----------------------------------------------------------------------------
# Offsite repository (restic). The credentials on this machine must be APPEND-ONLY: a REST
# server in --append-only mode, or an object-store key without delete rights. forget/prune
# run only from the maintainer's machine. Leave empty to keep local dumps only.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Optional heartbeat URL, pinged after each successful backup (/fail after a failed one).
BACKUP_HEARTBEAT_URL=
BACKUP_SCRATCH_SIZE=1g
