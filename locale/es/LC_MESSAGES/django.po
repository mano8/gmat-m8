#: apps/purchasing/templates/purchasing/no_candidates.html
#, python-format
msgid "This order ships to the worksite of %(project)s · %(name)s, so it only takes lines of that project."
msgstr "Este pedido se entrega en la obra de %(project)s · %(name)s, así que solo admite líneas de ese proyecto."

#: apps/purchasing/templates/purchasing/no_candidates.html
#, python-format
msgid "%(branch)s has lines to buy for %(projects)s and %(more)s other project."
msgid_plural "%(branch)s has lines to buy for %(projects)s and %(more)s other projects."
msgstr[0] "%(branch)s tiene líneas por comprar para %(projects)s y %(more)s proyecto más."
msgstr[1] "%(branch)s tiene líneas por comprar para %(projects)s y %(more)s proyectos más."

#: apps/purchasing/templates/purchasing/no_candidates.html
#, python-format
msgid "%(branch)s has lines to buy for %(projects)s."
msgstr "%(branch)s tiene líneas por comprar para %(projects)s."

#: apps/purchasing/templates/purchasing/no_candidates.html
msgid "To add them, change the destination under “Edit supplier, destination and notes”."
msgstr "Para añadirlas, cambia el destino en «Editar proveedor, destino y notas»."

#: apps/purchasing/templates/purchasing/no_candidates.html
msgid "They go on another order."
msgstr "Van en otro pedido."

#: apps/purchasing/templates/purchasing/no_candidates.html
#, python-format
msgid "%(branch)s has no approved line of that project left to buy."
msgstr "%(branch)s no tiene ninguna línea aprobada de ese proyecto por comprar."

#: apps/purchasing/templates/purchasing/no_candidates.html
#, python-format
msgid "%(branch)s has no approved line left to buy."
msgstr "%(branch)s no tiene ninguna línea aprobada por comprar."

#: apps/purchasing/templates/purchasing/no_candidates.html
msgid "A line reaches purchasing once its request is approved and it is sourced to purchase. Lines another draft already reserves in full are not offered either."
msgstr "Una línea llega a compras cuando su solicitud está aprobada y se ha decidido comprarla. Tampoco se ofrecen las líneas que otro borrador ya reserva por completo."

#: apps/purchasing/templates/purchasing/no_candidates.html
msgid "See what is to purchase"
msgstr "Ver lo que hay por comprar"
