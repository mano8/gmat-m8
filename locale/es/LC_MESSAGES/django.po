#: apps/accounts/templates/accounts/email/email_change_confirm.txt:1
msgid "An administrator asked to use this address for your gmat-m8 account."
msgstr ""
"Un administrador ha pedido usar esta dirección para tu cuenta de gmat-m8."

#: apps/accounts/templates/accounts/email/email_change_confirm.txt:3
#, python-format
msgid "Open this link to confirm it. It works once, for %(hours)s hours:"
msgstr ""
"Abre este enlace para confirmarla. Funciona una sola vez, durante %(hours)s "
"horas:"

#: apps/accounts/templates/accounts/email/email_change_confirm.txt:7
#, python-format
msgid ""
"The change takes effect %(cooling_off_hours)s hours after you confirm, "
"unless it is cancelled from the current address."
msgstr ""
"El cambio se aplica %(cooling_off_hours)s horas después de tu confirmación, "
"salvo que se cancele desde la dirección actual."

#: apps/accounts/templates/accounts/email/email_change_notice.txt:1
msgid ""
"An administrator asked to change the email address of your gmat-m8 account."
msgstr ""
"Un administrador ha pedido cambiar la dirección de correo de tu cuenta de "
"gmat-m8."

#: apps/accounts/templates/accounts/email/email_change_notice.txt:3
#, python-format
msgid ""
"If the new address confirms, the change takes effect %(cooling_off_hours)s "
"hours later and every session of your account ends."
msgstr ""
"Si la nueva dirección lo confirma, el cambio se aplica %(cooling_off_hours)s "
"horas después y se cierran todas las sesiones de tu cuenta."

#: apps/accounts/templates/accounts/email/email_change_notice.txt:5
msgid ""
"If you did not expect this, cancel the change with this link before it takes "
"effect:"
msgstr ""
"Si no lo esperabas, cancela el cambio con este enlace antes de que se "
"aplique:"

