#: apps/accounts/templates/accounts/email/email_change_confirm.txt:1
msgid "An administrator asked to use this address for your gmat-m8 account."
msgstr ""
"Un administrateur a demandé d'utiliser cette adresse pour votre compte gmat-"
"m8."

#: apps/accounts/templates/accounts/email/email_change_confirm.txt:3
#, python-format
msgid "Open this link to confirm it. It works once, for %(hours)s hours:"
msgstr ""
"Ouvrez ce lien pour la confirmer. Il fonctionne une seule fois, pendant "
"%(hours)s heures :"

#: apps/accounts/templates/accounts/email/email_change_confirm.txt:7
#, python-format
msgid ""
"The change takes effect %(cooling_off_hours)s hours after you confirm, "
"unless it is cancelled from the current address."
msgstr ""
"Le changement prend effet %(cooling_off_hours)s heures après votre "
"confirmation, sauf s'il est annulé depuis l'adresse actuelle."

#: apps/accounts/templates/accounts/email/email_change_notice.txt:1
msgid ""
"An administrator asked to change the email address of your gmat-m8 account."
msgstr ""
"Un administrateur a demandé de changer l'adresse e-mail de votre compte gmat-"
"m8."

#: apps/accounts/templates/accounts/email/email_change_notice.txt:3
#, python-format
msgid ""
"If the new address confirms, the change takes effect %(cooling_off_hours)s "
"hours later and every session of your account ends."
msgstr ""
"Si la nouvelle adresse confirme, le changement prend effet "
"%(cooling_off_hours)s heures plus tard et toutes les sessions de votre "
"compte se terminent."

#: apps/accounts/templates/accounts/email/email_change_notice.txt:5
msgid ""
"If you did not expect this, cancel the change with this link before it takes "
"effect:"
msgstr ""
"Si vous ne vous y attendiez pas, annulez le changement avec ce lien avant "
"qu'il ne prenne effet :"

#: apps/accounts/templates/accounts/email/invitation.txt:1
msgid "You have been invited to gmat-m8, the materials app of your company."
msgstr ""
"Vous avez été invité sur gmat-m8, l'application de matériel de votre société."

#: apps/accounts/templates/accounts/email/invitation.txt:3
#, python-format
msgid ""
"Open this link to accept the invitation. It works once, for %(hours)s hours:"
msgstr ""
"Ouvrez ce lien pour accepter l'invitation. Il fonctionne une seule fois, "
"pendant %(hours)s heures :"

#: apps/accounts/templates/accounts/email/invitation.txt:7
msgid "If you did not expect this invitation, ignore this message."
msgstr "Si vous ne vous attendiez pas à cette invitation, ignorez ce message."

#: apps/accounts/templates/accounts/email_change.html:4
msgid "Email change"
msgstr "Changement d'e-mail"

#: apps/accounts/templates/accounts/email_change.html:8
msgid "Confirm your new address"
