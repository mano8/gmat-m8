#: apps/accounts/templates/accounts/email_change.html:10
#, python-format
msgid "Use %(email)s for your gmat-m8 account."
msgstr "Utiliser %(email)s pour votre compte gmat-m8."

#: apps/accounts/templates/accounts/email_change.html:13
#, python-format
msgid ""
"The change applies %(cooling_off_hours)s hours after you confirm, unless it "
"is cancelled from the current address. Every session of the account then "
"ends."
msgstr ""
"Le changement s'applique %(cooling_off_hours)s heures après votre "
"confirmation, sauf s'il est annulé depuis l'adresse actuelle. Toutes les "
"sessions du compte se terminent alors."

