{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review --approve:*)",
      "Bash(gh pr review -a:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(git push * --tags:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:refs/heads/main:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit * --no-verify:*)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh release:*)",
      "PowerShell(gh workflow run:*)",
      "PowerShell(gh repo edit:*)",
      "PowerShell(gh secret:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git push --tags:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push origin HEAD:main:*)"
    ]
  }
}
